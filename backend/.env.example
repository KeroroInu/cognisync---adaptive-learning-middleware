# ===================================
# CogniSync 环境配置示例
# 复制此文件为 .env 并填写实际值
# ===================================

# ===================================
# 应用基础配置
# ===================================
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=text

# ===================================
# PostgreSQL 数据库配置
# ===================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cognisync
POSTGRES_PASSWORD=cognisync_dev_password_2024
POSTGRES_DB=cognisync_db
# 留空时使用上方 POSTGRES_* 组合；只在外部托管数据库时填写完整 URL。
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ===================================
# Neo4j 知识图谱配置
# ===================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cognisync_neo4j_2024

# Neo4j 向量索引（可选）
ENABLE_NEO4J_VECTOR_INDEX=false
EMBED_DIM=1536

# ===================================
# LLM Provider 配置
# ===================================
# 选择 LLM 提供者: mock | openai | ollama | lmstudio | deepseek
LLM_PROVIDER=mock
# 单次上游 HTTP 请求上限；分析和对话还有更严格的整轮预算
LLM_TIMEOUT_SECONDS=45
LLM_ANALYSIS_TIMEOUT_SECONDS=15
LLM_CHAT_TIMEOUT_SECONDS=30
LLM_MAX_CONCURRENCY=12
# 重试只在 provider 层执行，业务接口不再叠加重试
LLM_MAX_RETRIES=2
LLM_PROJECT_TEXT_ANALYSIS=rules

# DeepSeek 配置（推荐，性价比高）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI 配置
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama 本地模型配置
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:latest

# LM Studio 本地模型配置
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# ===================================
# Admin 管理员配置
# ===================================
# ⚠️ 生产环境必须设置强随机密钥！
ADMIN_KEY=your-secure-admin-key-here
SEED_DEFAULT_ADMIN=false
SEED_TEST_DATA=false

# ── 新注册用户的默认实验分组 ────────────────────────────────────────────────
# 合法值：unassigned | pdt | ai_pbl | lecture
#
# ⚠️ 正式实验必须保持 unassigned。
#
# unassigned 的用户在学生端只能访问画像与量表，看不到任何研究任务——这既是
# 保护（不会误入某个实验条件），也意味着试用时注册完会看到空白页面。
# 试用/联调阶段可以临时设成 pdt，让注册者直接进入项目解构流程。
#
# 设成具体组别后，**所有**新注册者都落进同一组，随机分配随之失效，组间差异
# 无法再归因于教学条件。而且 users 表里不会留下"这是被强制指定的"痕迹，
# 事后无法区分，整批数据只能作废。正式开放注册前务必改回 unassigned，
# 改用管理端逐个分配或随机分配接口。
DEFAULT_EXPERIMENT_GROUP=unassigned

# 仅当 SEED_DEFAULT_ADMIN=true 时使用；生产环境不要使用弱密码。
ADMIN_DEFAULT_STUDENT_ID=
ADMIN_DEFAULT_PASSWORD=
ADMIN_DEFAULT_NAME=系统管理员

# ===================================
# JWT 认证配置
# ===================================
# ⚠️ 生产环境必须设置强随机字符串！
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1440

# ===================================
# CORS 配置
# ===================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
