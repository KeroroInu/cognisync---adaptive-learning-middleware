# Package an already verified Vite dist/ without embedding local .env files.
# Build context must contain only dist/ and nginx.conf.
FROM nginx:alpine
COPY dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
RUN find /usr/share/nginx/html -type f \( -name '*.js' -o -name '*.css' -o -name '*.wasm' -o -name '*.json' -o -name '*.html' \) -exec gzip -k -6 '{}' \;
EXPOSE 80
