# =============================================================================
# CogniSync 根目录环境变量（docker compose 用）
#
# 复制为 .env 后再改：cp .env.example .env
#
# 为什么需要这一份，而不是只有 backend/.env：
#   compose 文件里 ${VAR} 形式的替换发生在**解析 compose 文件时**，
#   只读取根目录 .env 和 shell 环境；服务里的 `env_file: ./backend/.env`
#   是把变量注入**容器内部**，两者时机完全不同、互不可见。
#   所以下面这几个变量必须在这里定义，写进 backend/.env 无效。
#
# 生产环境必须全部改成真实值。backend/main.py 会在 APP_ENV=production 时
# 校验 ADMIN_KEY / JWT_SECRET / POSTGRES_PASSWORD 的强度，弱口令会直接拒绝启动。
# =============================================================================

# ── 必填：缺失会导致 compose 直接报错拒绝启动 ────────────────────────────────
# 管理后台的访问密钥。生产环境要求至少 24 位。
# 生成建议：openssl rand -base64 36
ADMIN_KEY=change-me-to-a-long-random-admin-key

# ── 运行模式 ────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# 仅供 compose 的 healthcheck (pg_isready -U ...) 使用。
# 必须与 backend/.env 里的 POSTGRES_USER 一致，否则健康检查永远失败，
# backend 会一直卡在 depends_on: service_healthy 而起不来。
POSTGRES_USER=cognisync

# ── Neo4j ───────────────────────────────────────────────────────────────────
# 格式是 "用户名/密码"，这是 Neo4j 官方镜像的约定，不是随意写法。
#
# ⚠️ 必须与 backend/.env 里的 NEO4J_USER / NEO4J_PASSWORD 对应：
#      NEO4J_AUTH=neo4j/你的密码
#      backend/.env: NEO4J_USER=neo4j
#                    NEO4J_PASSWORD=你的密码
#
# 这两处只要对不上，后端就会连不上图谱。而连不上是**静默的**：
# main.py 只记一条日志就继续启动，/health 也只检查 postgres 仍返回 200，
# 但认知维度是从知识图谱算出来的——整个班的认知数据会悄悄降级。
# 改密码时务必两边一起改，改完用 backend/scripts/check_neo4j.py 验证。
#
# 注意：Neo4j 的密码写在数据卷里，首次启动后再改 NEO4J_AUTH 不会生效，
# 需要先删除 neo4j-data 卷（会丢图谱数据）或进容器里手动改密码。
NEO4J_AUTH=neo4j/change-me-to-a-strong-neo4j-password

# ── 构建期镜像源（可选）────────────────────────────────────────────────────
# 留空即走官方源。国内服务器强烈建议设置：实测官方 Debian 源约 157 KB/s，
# 而腾讯云内网镜像约 930 KB/s，不设置时 apt-get update 可能直接把构建拖死。
# 这些只影响构建过程，不进入运行时镜像。
#
# 腾讯云主机（内网免流量费）：
#   APT_MIRROR=http://mirrors.tencentyun.com/debian
#   PIP_INDEX_URL=https://mirrors.tencentyun.com/pypi/simple
#   NPM_REGISTRY=https://registry.npmmirror.com
#   APK_MIRROR=http://mirrors.tencentyun.com/alpine
#
# 阿里云主机：
#   APT_MIRROR=http://mirrors.cloud.aliyuncs.com/debian
#   PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
#   APK_MIRROR=https://mirrors.aliyun.com/alpine
#
# APK_MIRROR 供学生端前端镜像使用（node:20-alpine 里装 bash）。别小看这一项：
# 不设时 Alpine 官方 CDN 在国内实测装一个 bash 要 293 秒，构建看上去像卡死。
APT_MIRROR=
PIP_INDEX_URL=
NPM_REGISTRY=
APK_MIRROR=
